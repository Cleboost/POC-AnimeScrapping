{
  "name": "anime-scraping-lib",
  "version": "0.1.0",
  "description": "Multi-platform anime scraping library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/anime-scraping-lib.d.ts",
      "import": "./dist/anime-scraping-lib.js",
      "default": "./dist/anime-scraping-lib.js"
    }
  },
  "bin": {
    "anime-scrap": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:release": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build src/index.ts --outfile dist/anime-scraping-lib.js --target node --format esm --minify --packages=external",
    "build:types": "rollup -c rollup.dts.config.js",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/cli.ts",
    "start": "bun src/cli.ts",
    "playground": "bun playground/demo.ts",
    "playground:bundle": "bun playground/from-bundle.ts",
    "test": "bun test tests",
    "test:unit": "bun test tests/unit",
    "test:contract": "bun test tests/contract",
    "test:browser": "RUN_BROWSER_TESTS=1 bun test tests/contract/providers/browser.test.ts",
    "test:hosts": "RUN_LIVE_HOST_TESTS=1 bun test tests/contract/providers/http-hosts.test.ts"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.8.2"
  }
}
